# ============================================================
# Variables de entorno
# ============================================================
# Este archivo es una plantilla. Copialo a `.env.local` (que NO se commitea)
# y completá los valores para correr la app contra un backend real.
#
# Sin ninguna de estas variables la app arranca sola en MODO DEMO: datos
# ficticios en memoria, sin base de datos ni credenciales. Es el modo con el
# que corre la demo pública.

# --- Forzar el modo (opcional) ---
# "true"  → siempre demo, aunque haya credenciales de Supabase
# "false" → siempre live, exige las variables de Supabase
# sin definir → demo si no hay credenciales, live si las hay
# VITE_DEMO_MODE=true

# --- Supabase ---
# VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...
# La `service_role` NUNCA va acá: viviría en el bundle público. Las operaciones
# privilegiadas pasan por la Edge Function `manage-users`.

# --- Webhooks de n8n ---
# VITE_N8N_WEBHOOK_URL=          # facturación AFIP
# VITE_N8N_WEBHOOK_TOKEN=        # Bearer para todos los webhooks
# VITE_N8N_AVISOS_URL=           # avisos de cuota
# VITE_N8N_AUMENTOS_URL=         # notificación de aumentos
# VITE_N8N_FACTURAS_URL=         # OCR de facturas de compra
# VITE_N8N_SUELDOS_URL=          # import de recibos de sueldo
